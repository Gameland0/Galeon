// 动态根据当前域名设置API地址，支持本地和测试网
const host = window.location.host;
let API_URL = '';
if (host.includes('testai.gameland.network')) {
  API_URL = 'https://testaiservice.gameland.network/api';
} else if (host.includes('localhost')) {
  API_URL = 'http://localhost:8080/api';
} else {
  // 默认使用相对路径，依赖前端proxy或生产配置
  API_URL = 'https://galeon.gameland.network/api';
}
const baseURL = API_URL;

export const api = axios.create({
  baseURL,
  timeout: 60000, // 60 seconds timeout for blockchain operations
  // baseURL:'https://testnet-api.gameland.network'
});

api.interceptors.request.use((config: any) => {
  // 如果已经设置了 Authorization header（比如 Privy token），不要覆盖
  if (!config.headers['Authorization']) {
    const token = localStorage.getItem('token');
    if (token) {
      config.headers['Authorization'] = `Bearer ${token}`;
    }
  }
  return config;
});

