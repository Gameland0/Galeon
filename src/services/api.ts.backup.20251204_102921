    // 调用后端的部署API
    const response = await api.post('/solana/deploy', data);

    console.log('✅ Backend deployment completed:', response.data);

    return {
      programId: response.data.programId,
      signature: response.data.signature,
      logs: response.data.logs
    };

  } catch (error: any) {
    console.error('Backend deployment failed:', error);
    throw new Error(error.response?.data?.error || 'Failed to deploy Solana program via backend');
  }
};

