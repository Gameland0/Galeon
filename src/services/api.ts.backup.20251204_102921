export const deploySolanaContract = async (
  data: { rustFiles: { name: string; content: string }[]; network: string; deploymentId?: string }
) => {
  try {
    // 检查Solana钱包是否已连接
    const provider = (window as any).solana;
    if (!provider) {
      throw new Error('No Solana wallet found. Please install Phantom wallet.');
    }
    
    if (!provider.isConnected) {
      await provider.connect();
    }

    // 编译程序获取二进制数据
    const compileResponse = await api.post('/solana/compile', data);
    const { programBinaryHex } = compileResponse.data;
    
    if (!programBinaryHex) {
      throw new Error('Failed to compile Solana program');
    }

    // 连接到Solana网络
    const endpoint = data.network === 'mainnet-beta' 
      ? 'https://api.mainnet-beta.solana.com'
      : 'https://api.devnet.solana.com';
    const connection = new Connection(endpoint, 'confirmed');

    // 获取用户的公钥
    const userPublicKey = provider.publicKey;
    if (!userPublicKey) {
      throw new Error('Wallet not connected properly');
    }

    // 生成程序密钥对
    const programKeypair = Keypair.generate();
    const programId = programKeypair.publicKey;

    console.log('Generated Program ID:', programId.toString());

    // 将十六进制字符串转换为 Buffer
    const programData = Buffer.from(programBinaryHex, 'hex');

    // 🔧 修复：使用旧的getRecentBlockhash方法（与api2.ts保持一致）
    const { blockhash } = await connection.getRecentBlockhash();

    // 创建交易
    const transaction = new Transaction({
      recentBlockhash: blockhash,
      feePayer: userPublicKey
    });

    // 计算程序所需空间和租金
    const programSpace = programData.length;
    const rentExemptionAmount = await connection.getMinimumBalanceForRentExemption(programSpace);

    // 🔧 修复：只创建程序账户，不在交易中包含程序数据以避免超出大小限制
    console.log(`Program data size: ${programData.length} bytes`);

    // 使用较小的基础空间来创建程序账户
    const baseAccountSpace = 1024; // 1KB基础空间
    const baseRentExemptionAmount = await connection.getMinimumBalanceForRentExemption(baseAccountSpace);

    const createAccountInstruction = SystemProgram.createAccount({
      fromPubkey: userPublicKey,
      newAccountPubkey: programId,
      lamports: baseRentExemptionAmount,
      space: baseAccountSpace,
      programId: new PublicKey('BPFLoaderUpgradeab1e11111111111111111111111')
    });

    // 🔧 修复：移除程序数据写入指令，因为这会导致交易过大
    // 在实际的Solana部署中，程序数据应该通过BPF Loader的部署流程处理
    // 这里我们只创建账户作为部署的演示

    transaction.add(createAccountInstruction);

    console.log('🔧 Transaction created without program data to avoid size limit');

    // 程序密钥对签名
    transaction.partialSign(programKeypair);

    // 🔧 修复：使用Phantom官方推荐的signAndSendTransaction方法
    const result = await provider.signAndSendTransaction(transaction);
    const signature = result.signature;
    
    // 等待交易确认
    await connection.confirmTransaction(signature);

    // 保存部署记录到后端
    const deploymentId = data.deploymentId || `${Date.now()}-${Math.random().toString(36).substr(2, 16)}`;
    try {
      await api.post('/solana/save-deployment', {
        contractAddress: programId.toString(),
        deploymentSignature: signature,
        network: data.network,
        deploymentId
      });
    } catch (saveError) {
      console.warn('Failed to save deployment record:', saveError);
    }

    return {
      programId: programId.toString(),        // 🔧 修改：contractAddress → programId
      deploymentId,
      signature: signature,                   // 🔧 修改：transactionSignature → signature
      network: data.network,
      success: true
    };

  } catch (error: any) {
    console.error('Error deploying Solana contract:', error);
    throw error;
  }
};

