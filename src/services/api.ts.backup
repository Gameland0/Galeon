// 添加window类型扩

import { Buffer } from 'buffer';
import axios from 'axios';
import Web3 from 'web3';
import { Connection, Transaction, SystemProgram, Keypair, PublicKey, TransactionInstruction } from '@solana/web3.js';

// 动态根据当前域名设置API地址，支持本地和测试网
const host = window.location.host;
let API_URL = '';
if (host.includes('testai.gameland.network')) {
  API_URL = 'https://testaiservice.gameland.network/api';
} else if (host.includes('localhost')) {
  API_URL = 'http://localhost:8080/api';
} else {
  // 默认使用相对路径，依赖前端proxy或生产配置
  API_URL = 'https://galeon.gameland.network/api';
}
const baseURL = API_URL;

export const api = axios.create({
  baseURL,
  // baseURL:'https://testnet-api.gameland.network'
});

api.interceptors.request.use((config: any) => {
  const token = localStorage.getItem('token');
  if (token) {
    config.headers['Authorization'] = `Bearer ${token}`;
  }
  return config;
});

export interface Agent {
  id: number;
  name: string;
  description: string;
  type: string;
  is_public: boolean;
  owner: string;
  imageUrl?: string;
  agentid: number;
  chainid: number;
  trainingData?: {
    ipfsHash: string;
    trained_at: string;
    userAddress: string;
  }[];
}

interface CompileContractInput {
  source: string;
}

interface CompileContractResult {
  success: boolean;
  contractName?: string;
  abi?: any[];
  bytecode?: string;
  error?: string;
  warnings?: string[];
}

export interface ContractVerificationRequest {
  address: string;
  source: string;
  network: string;
  contractType: string;
  constructorArguments?: string[];
}

export interface ContractVerificationResponse {
  success: boolean;
  message: string;
  details?: string;
}


export interface CreditInfo {
  creditBalance: number;
  buyBalance: number;
  lastUsedAt?: string;
  lastResetAt?: string;
}

