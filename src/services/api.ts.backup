export interface EIP1559GasPrice {
  maxFeePerGas: string;
  maxPriorityFeePerGas: string;
  gasPrice: string;  // 确保gasPrice属性存在
  isEIP1559Supported: boolean;
}

export type GasPriceType = string | EIP1559GasPrice;

export const getGasPrice = async (networkId: number): Promise<EIP1559GasPrice> => {
  const web3 = new Web3(window.ethereum);
  
  try {
    // 尝试获取EIP-1559费用估算
    const feeData = await web3.eth.getFeeHistory(4, 'latest', [25, 50, 75]);
    
    // 计算优先级费用的中位数
    const priorityFeePercentile = feeData.reward ? 
      BigInt(feeData.reward[1][1].toString()) : // 确保使用BigInt
      BigInt(1000000000); // 默认1 Gwei
    
    // 获取当前基础费用
    const block = await web3.eth.getBlock('latest');
    // 确保baseFee是BigInt类型
    const baseFee = block.baseFeePerGas ? BigInt(block.baseFeePerGas.toString()) : BigInt(0);
    
    // 现在两个操作数都是BigInt类型
    const maxPriorityFeePerGas = priorityFeePercentile;
    const maxFeePerGas = baseFee + maxPriorityFeePerGas;
    
    return {
      maxFeePerGas: maxFeePerGas.toString(),
      maxPriorityFeePerGas: maxPriorityFeePerGas.toString(),
      gasPrice: (baseFee + maxPriorityFeePerGas).toString(), // 兼容旧版本
      isEIP1559Supported: true
    };
  } catch (error) {
    console.warn('EIP-1559 fee estimation failed, falling back to legacy gas price', error);
    // 回退到传统gas price
    const gasPrice = await web3.eth.getGasPrice();
    return {
      gasPrice: (BigInt(gasPrice.toString()) * BigInt(120) / BigInt(100)).toString(), // 增加20%
      maxFeePerGas: "0", // 添加这些属性确保返回类型一致
      maxPriorityFeePerGas: "0",
      isEIP1559Supported: false
    };
  }
};

export const deployContract = async (
  abi: any[], 
  bytecode: string, 
  params: any[], 
  from: string,
  networkId: number,
  gasPrice: GasPriceType
) => {
  if (!window.ethereum) {
    throw new Error('No web3 provider found');
  }

  const web3 = new Web3(window.ethereum);
  
  // 切换到正确的网络
  await window.ethereum.request({
    method: 'wallet_switchEthereumChain',
    params: [{ chainId: web3.utils.toHex(networkId) }]
  });
  
  // 创建合约实例
  const contract = new web3.eth.Contract(abi);
  
  // 处理字节码格式
  let processedBytecode = bytecode;
  
  // 确保字节码以 0x 开头
  if (!processedBytecode.startsWith('0x')) {
    processedBytecode = '0x' + processedBytecode;
  }
  
  // 确保字节码长度是偶数
  if (processedBytecode.length % 2 !== 0) {
    processedBytecode = processedBytecode + '0';
  }
  
  // 验证字节码格式
  const compilerVersionMatch = processedBytecode.match(/^0x(?:[0-9a-fA-F][0-9a-fA-F])*$/);
  if (!compilerVersionMatch) {
    console.error('Invalid bytecode format:', processedBytecode);
    throw new Error('Invalid bytecode format. Please ensure the bytecode is a valid hexadecimal string starting with 0x');
  }
  
  // 准备部署交易
  const deploy = contract.deploy({
    data: processedBytecode,
    arguments: params
  });
  
  // 特殊网络可能需要更高的gas限制
  const isZkEVM = networkId === 1101 || networkId === 2442;
  const gasMultiplier = isZkEVM ? 1.2 : 1.1;
  
  // 估算 gas
  const gas = await deploy.estimateGas({ from });
  const gasLimit = BigInt(Math.round(Number(gas) * gasMultiplier));
  
  // 检查是否支持EIP-1559
  let txParams: any = {
    from,
    gas: gasLimit
  };
  
  // 根据是否支持EIP-1559设置不同的gas参数
  if (typeof gasPrice === 'object' && gasPrice.isEIP1559Supported) {
    // 使用EIP-1559交易类型
    txParams.maxFeePerGas = BigInt(gasPrice.maxFeePerGas);
    txParams.maxPriorityFeePerGas = BigInt(gasPrice.maxPriorityFeePerGas);
  } else {
    // 使用传统交易类型
    if (typeof gasPrice === 'string') {
      txParams.gasPrice = BigInt(gasPrice);
    } else {
      txParams.gasPrice = gasPrice.gasPrice ? BigInt(gasPrice.gasPrice) : BigInt(0);
    }
  }

  try {
    // 发送部署交易
    const deployedContract = await deploy.send(txParams);
    return deployedContract.options.address;
  } catch (error: any) {
    console.error('Deployment error:', error);
    throw new Error(`Failed to deploy contract: ${error.message}`);
  }
};

