# 管理员钱包地址（用于访问Admin Panel）
# 将此地址替换为实际的管理员MetaMask钱包地址
REACT_APP_ADMIN_WALLET_ADDRESS=0xYourAdminWalletAddressHere

# 示例：
# REACT_APP_ADMIN_WALLET_ADDRESS=0x742d35Cc6634C0532925a3b844Bc9e7595f0bEb

# [2026-09-22] Hyperliquid Integration
# Brain 统一 Agent 钱包地址（与服务器 HL_AGENT_ADDRESS 一致）
REACT_APP_HL_AGENT_ADDRESS=
# Galeon Builder Fee 地址（与服务器 HL_BUILDER_ADDRESS 一致）
REACT_APP_HL_BUILDER_ADDRESS=
