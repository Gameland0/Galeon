    "deploy:base-testnet": "hardhat run scripts/deploy.js --network baseTestnet",
    "deploy:base": "hardhat run scripts/deploy.js --network base",
    "verify": "hardhat verify --network bsc"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "dotenv": "^16.3.1",
    "hardhat": "^2.19.0"
  }
}
